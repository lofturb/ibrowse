			<key>CFBundleURLSchemes</key>
			<array>
				<string>ibrowse</string>
			</array>
		</dict>
	</array>

	<!-- iOS 9 trae raices TLS de 2016. El perfil CertificadosModernos.mobileconfig
	     del kit resuelve la mayoria de fallos HTTPS. NSAllowsArbitraryLoads solo
	     permite HTTP plano; no valida certificados. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>

	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
